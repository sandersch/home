! ============================================================================
! Cisco Catalyst WS-C3850-48P  ·  hostname: catalyst  ·  mgmt 10.137.10.2
! ----------------------------------------------------------------------------
! Source-of-truth running-config for the Layer-2 distribution switch.
! Mirrors docs/network.md (Network Step 2 + Local Camera Isolation block).
! This is a TEMPLATE: secrets are redacted (see README) and a few lines marked
! "(exec)" are run from privileged EXEC at restore time, not pasted as config.
!
! INVARIANTS (docs/network.md → Canonical Invariants — do not violate):
!   * Strictly L2. 'ip routing' stays OFF. The VLAN 10 SVI is a management host
!     IP only, never an inter-VLAN gateway — the UDM Pro routes everything.
!   * VLAN 105 (cameras) is NEVER added to the Te1/1/4 uplink trunk.
!   * VLAN 99 is the empty blackhole native VLAN on the trunk.
!   * The Gi1/0/5 bastion stanza is committed target state; keep the live port
!     access VLAN 30 until runbooks/bastion reaches the attended trunk cutover.
! ============================================================================

service password-encryption
!
hostname catalyst
!
! Keep management auth local and simple: the privilege-15 admin account is the
! SSH path, and the console remains the deliberate break-glass path.
no aaa new-model
!
! --- Strictly Layer 2 ----------------------------------------------------
! 'ip routing' is disabled by default; keep it that way. No 'ip routing' line
! is emitted on purpose. The single SVI below is a host IP, not routing.
no ip routing
!
! --- VLAN database (VTP transparent: manage the DB locally, ignore VTP) ---
vtp mode transparent
!
vlan 10
 name admin-mgmt
vlan 20
 name servers
vlan 30
 name trusted-fastlane
vlan 60
 name iot
vlan 80
 name guest
vlan 99
 name blackhole-native
vlan 105
 name cameras
!
! --- Spanning tree -------------------------------------------------------
spanning-tree mode rapid-pvst
!
! --- Management interface -------------------------------------------------
! VLAN 10 SVI = the switch's own management address. NOT a gateway: with
! 'no ip routing' this terminates traffic for the box only.
interface Vlan10
 description catalyst management SVI (host IP, not routing)
 ip address 10.137.10.2 255.255.255.0
 no shutdown
!
! Reach the VLAN 30 bastion and other off-subnet sources via the UDM. Required
! because the L2 switch has no routing table of its own.
ip default-gateway 10.137.10.1
! Use the bastion's VLAN 10-only OpenNTPD service. Apply only after the bastion
! listener, upstream synchronization, and PF exception pass validation.
ntp server 10.137.10.8
!
! Vlan1 must be explicitly shut — it exists by default on every IOS switch and
! must never carry traffic on a managed deployment.
interface Vlan1
 no ip address
 shutdown
!
! ============================================================================
! UPLINK TRUNK  ·  Te1/1/4 → UDM Port 10 (10G DAC)
! ============================================================================
! Native VLAN 99 must match the UDM side or untagged frames land in a live
! VLAN and the blackhole design breaks. VLAN 99 is in the allowed list so the
! trunk carries its own native VLAN. VLAN 105 is deliberately EXCLUDED.
! (No 'switchport trunk encapsulation' — the 3850 is dot1q-only.)
interface TenGigabitEthernet1/1/4
 description Uplink to UDM Port 10 (10G DAC trunk)
 switchport mode trunk
 switchport trunk native vlan 99
 switchport trunk allowed vlan 10,20,30,60,80,99
!
! ============================================================================
! ACCESS PORTS
! ============================================================================
!
! IPMI / IPKVM out-of-band management (reserved block — not general client use)
interface range GigabitEthernet1/0/1-4
 description IPMI/IPKVM out-of-band mgmt (VLAN 10)
 switchport mode access
 switchport access vlan 10
 spanning-tree portfast
 spanning-tree bpduguard enable
!
! Restricted bastion trunk. Untagged traffic is parked in empty VLAN 99; the
! Wyse consumes only tagged VLANs 10 and 30. DTP is explicitly disabled.
interface GigabitEthernet1/0/5
 description bastion restricted trunk (OpenBSD)
 switchport mode trunk
 switchport trunk native vlan 99
 switchport trunk allowed vlan 10,30,99
 switchport nonegotiate
 spanning-tree portfast trunk
 spanning-tree bpduguard enable
!
! General wired clients. Convenience default: anything plugged in just works.
! Unused ports stay here on VLAN 30 by design (home-network tradeoff), not
! disabled or parked in VLAN 99.
interface range GigabitEthernet1/0/6-36
 description General wired clients (VLAN 30)
 switchport mode access
 switchport access vlan 30
 spanning-tree portfast
 spanning-tree bpduguard enable
!
! Camera deployment ports (11-port reserved range; 4 cameras today).
! 'switchport protected' stops cameras talking to each other; block
! unicast/multicast stops unknown-unicast and flood frames leaking between
! them. Cameras can still reach the NVR port (Gi1/0/48, below).
interface range GigabitEthernet1/0/37-47
 description IP cameras (VLAN 105, isolated)
 switchport mode access
 switchport access vlan 105
 switchport protected
 switchport block unicast
 switchport block multicast
 spanning-tree portfast
 spanning-tree bpduguard enable
!
! minis NVR camera-side ingestion (cam0). INTENTIONALLY OMITS 'switchport
! protected' and the block statements so the protected camera ports above can
! reach this one port. Do not add protection here.
interface GigabitEthernet1/0/48
 description minis NVR camera-side ingestion (cam0, VLAN 105)
 switchport mode access
 switchport access vlan 105
 spanning-tree portfast
 spanning-tree bpduguard enable
!
! ============================================================================
! DEVICE MANAGEMENT HARDENING
! ============================================================================
! Secret redacted per the repo's no-plaintext rule — restore from the password
! manager (see README). This stores an irreversible hash on the box once set;
! the cleartext is never committed. No enable secret is set intentionally: the
! privilege-15 local admin account is the remote admin path, and console access
! remains the break-glass path without an additional enable credential.
username admin privilege 15 secret __REPLACE_WITH_ADMIN_SECRET__
!
! SSH only — no plaintext telnet on the vty lines.
ip domain name mgmt.matrix
ip ssh version 2
! (exec) generate the host key once after setting 'ip domain name':
!   crypto key generate rsa modulus 2048
!
! Allow admin SSH public-key auth through the bastion workflow.
! NOTE: once imported, IOS renders this key as a 'key-hash ssh-rsa' line in the
! running-config, not the key-string below. Expected hash (MD5 of the key blob):
!   B5AB422B09EC7E4BA530D0E87C76A750
! Match that against 'show running-config' to confirm sync without re-importing.
ip ssh pubkey-chain
 username admin
  key-string
   AAAAB3NzaC1yc2EAAAADAQABAAABAQDHTbN0W4L70cw983m+wFmmRc8u3SdPFACD0ZZYO+qaDaiMQURH
   DgzINOghOSPNtCCTXSvdYMoWwSFyAEa6rZIPHpXKxtuMQR3Cd0B2CyfrjHigk9E3Gn9SgDyeCrhHAYDn
   zoVbqhE08kQz5xwzgsAfY679xgWUmX0nXEalBWUOEE/fqlLPSwuGHgFgeNueip5XwDdw1Hd+sEvWC3fj
   BVaHsdPDftk39KX1ARGtl8XpvwUYh5TRR5EUCQt5BxHXOhTkFzXPlzhzTiJjrTfc/Cg9WjCVltrBOlwp
   M/EsuOQ/m7EVFrwaAnvNTdj2ErfqfjrKq1F1RsmdzgFyfCRHFoJB
  exit
!
! Kill the web UIs; manage over SSH.
no ip http server
no ip http secure-server
! IOS may still render 'ip http authentication local'; harmless while both
! HTTP/HTTPS servers remain disabled.
!
! NOTE: the box also shows a 'call-home'/'service call-home' block (not emitted
! here). It is force-enabled by Smart-Licensing and cannot be disabled — left
! as-is by decision, not an out-of-sync drift.
!
! Log successful logins (audit trail for console/vty access).
login on-success log
!
! Console is the deliberate break-glass path: NO 'login local' and (with no
! enable secret set above) physical console access is intentionally
! unauthenticated and lands at privilege 15. Recovery must not depend on a
! credential. Remote admin is gated on the vty/SSH lines below instead.
line con 0
 stopbits 1
!
line vty 0 15
 login local
 transport input ssh
 exec-timeout 15 0
!
end
