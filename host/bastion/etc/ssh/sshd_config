# Single-purpose bastion: key-only access on the operator-side address.
AddressFamily inet
ListenAddress 10.137.30.9:22
PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
AuthenticationMethods publickey
AllowUsers charlie

# ProxyJump, client-side local forwards, and SOCKS are allowed. Server-side
# remote forwards, agent sockets, X11, and IP tunnels are not.
AllowTcpForwarding local
AllowStreamLocalForwarding local
GatewayPorts no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no

PermitUserEnvironment no
HostbasedAuthentication no
IgnoreRhosts yes
MaxAuthTries 3
LoginGraceTime 30
LogLevel VERBOSE
Subsystem sftp internal-sftp
