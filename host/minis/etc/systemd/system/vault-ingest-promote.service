[Unit]
Description=Validate and promote vault-ingestion uploads
After=local-fs.target
ConditionPathIsMountPoint=/mnt/vault

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/vault-ingest-promote
User=root
Group=root
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/mnt/vault /var/lib/node-exporter/textfile
ProtectHome=yes
