[Unit]
Description=Harden the uncovered backups mountpoint
DefaultDependencies=no
After=systemd-remount-fs.service
Before=local-fs-pre.target mnt-backups.automount mnt-backups.mount local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/backups-mountpoint-guard
RemainAfterExit=yes

[Install]
WantedBy=local-fs-pre.target
