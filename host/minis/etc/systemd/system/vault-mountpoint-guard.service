[Unit]
Description=Harden the uncovered encrypted vault mountpoint
DefaultDependencies=no
After=systemd-remount-fs.service
Before=local-fs-pre.target mnt-vault.mount local-fs.target
ConditionPathExists=/etc/homelab/vault.conf

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/vault-mountpoint-guard
RemainAfterExit=yes

[Install]
WantedBy=local-fs-pre.target
